{
  "appId": "net.easyhud.player",
  "productName": "Easy HUD Player",
  "icon": "build/icon.ico",
  "compression": "maximum",
  "files": [
    "app/**/*",
    "package.json",
    "LICENSE"
  ],
  "electronLanguages": [
    "en-US"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": false,
    "deleteAppDataOnUninstall": true,
    "artifactName": "EasyHUD-Player-Setup.${ext}"
  }
}
